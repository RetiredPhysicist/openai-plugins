{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dejavu": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server/bridge.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "DEJAVU_URL": "https://dejavu.example.com/mcp",
        "DEJAVU_CLIENT_ID": "${DEJAVU_CLIENT_ID}",
        "DEJAVU_CLIENT_SECRET": "${DEJAVU_CLIENT_SECRET}"
      }
    }
  }
}
