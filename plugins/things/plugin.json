{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "things",
  "version": "1.0.0",
  "description": "Your Things 3 to-dos in a Codex workspace.",
  "author": {
    "name": "RetiredPhysicist",
    "url": "https://github.com/RetiredPhysicist"
  },
  "homepage": "https://github.com/RetiredPhysicist/openai-plugins",
  "repository": "https://github.com/RetiredPhysicist/openai-plugins",
  "license": "MIT",
  "keywords": [
    "things",
    "todo",
    "tasks",
    "macos",
    "productivity",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/things/SKILL.md",
      "interface": {
        "displayName": "Things",
        "shortDescription": "Browse and manage Things 3 to-dos",
        "longDescription": "Things opens your Things 3 data in a Codex workspace: Inbox, Today, Upcoming, Anytime, Someday, projects, areas, tags, search, task details, quick add, and completion. Reads come straight from the local Things database; writes go through Things itself, and every change is verified by reading the item back. Runs locally on macOS with no account, cloud service, or background helper.",
        "developerName": "RetiredPhysicist",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/RetiredPhysicist/openai-plugins",
        "privacyPolicyURL": "https://github.com/RetiredPhysicist/openai-plugins",
        "termsOfServiceURL": "https://github.com/RetiredPhysicist/openai-plugins",
        "defaultPrompt": [
          "Open my Things workspace.",
          "Plan my day from my Things Today list."
        ],
        "brandColor": "#2F6F4E",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/logo.svg"
      }
    }
  }
}
